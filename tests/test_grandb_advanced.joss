// Test de GranDB ORM Multimotor (SQLite, MySQL, PostgreSQL, SQL Server) y Dinámico

print("========================================================\n")
print("   PRUEBA AVANZADA DE GRANDB ORM Y MULTIMOTOR\n")
print("========================================================\n")

// 1. Cambio dinámico a SQLite local para pruebas inmediatas
$db_switched = System::change_db("sqlite", {
    "DB_PATH": "test_grandb.sqlite",
    "DB_PREFIX": "app_"
})

($db_switched) ? {
    print("[1] System::change_db a SQLite con prefijo 'app_': OK\n")
} : {
    print("[1] System::change_db FALLÓ\n")
}

// 2. Creación de tabla con Schema
Schema::dropIfExists("products")
Schema::create("products", {
    "id": "increments",
    "name": "string(100)",
    "category": "string(50)",
    "price": "decimal(10,2)",
    "stock": "integer|default(0)",
    "is_active": "boolean|default(1)",
    "description": "text|nullable",
    "created_at": "timestamp|nullable",
    "updated_at": "timestamp|nullable"
})

$has_table = Schema::hasTable("products")
print("[2] Schema::hasTable('products'): " . ($has_table ? "SI" : "NO") . "\n")

$has_col = Schema::hasColumn("products", "price")
print("[3] Schema::hasColumn('products', 'price'): " . ($has_col ? "SI" : "NO") . "\n")

// 3. Inserción con GranDB (insertGetId e insert)
$p1 = GranDB::table("products")->insertGetId({
    "name": "Laptop Pro",
    "category": "Electronics",
    "price": 1299.99,
    "stock": 10,
    "is_active": 1,
    "created_at": now()
})
print("[4] insertGetId producto 1: " . $p1 . "\n")

$p2 = GranDB::table("products")->insertGetId({
    "name": "Mouse Gaming",
    "category": "Electronics",
    "price": 49.99,
    "stock": 50,
    "is_active": 1,
    "created_at": now()
})
print("[5] insertGetId producto 2: " . $p2 . "\n")

$p3 = GranDB::table("products")->insertGetId({
    "name": "Silla Ergonómica",
    "category": "Office",
    "price": 250.00,
    "stock": 5,
    "is_active": 1,
    "created_at": now()
})
print("[6] insertGetId producto 3: " . $p3 . "\n")

// 4. Consultas Fluent Where, In, Between, Like
$count_all = GranDB::table("products")->count()
print("[7] Total productos (count): " . $count_all . "\n")

$electronics = GranDB::table("products")->where("category", "Electronics")->get()
print("[8] Productos en Electronics: " . len($electronics) . "\n")

$in_prices = GranDB::table("products")->whereBetween("price", [40.0, 300.0])->get()
print("[9] Productos precio entre 40 y 300: " . len($in_prices) . "\n")

$first_prod = GranDB::table("products")->where("name", "Laptop Pro")->first()
print("[10] First producto: " . $first_prod["name"] . " ($" . $first_prod["price"] . ")\n")

// 5. Pluck y Distinct
$categories = GranDB::table("products")->distinct()->pluck("category")
print("[11] Categorías únicas (distinct + pluck): " . implode(", ", $categories) . "\n")

// 6. Update, Increment y Delete
GranDB::table("products")->where("id", $p1)->increment("stock", 5)
$updated_p1 = GranDB::table("products")->where("id", $p1)->first()
print("[12] Stock tras increment(+5): " . $updated_p1["stock"] . "\n")

GranDB::table("products")->where("id", $p3)->delete()
$count_after_del = GranDB::table("products")->count()
print("[13] Total tras borrar p3: " . $count_after_del . "\n")

// 7. Transacciones con GranDB::transaction()
GranDB::transaction(function($db) {
    GranDB::table("products")->insert({
        "name": "Teclado Mecánico",
        "category": "Electronics",
        "price": 89.90,
        "stock": 15,
        "is_active": 1,
        "created_at": now()
    })
})
$count_after_tx = GranDB::table("products")->count()
print("[14] Conteo tras transacción: " . $count_after_tx . "\n")

// Limpieza de archivo de prueba sqlite
unlink("test_grandb.sqlite")

print("========================================================\n")
print("   TODAS LAS PRUEBAS DE GRANDB ORM EXITOSAS\n")
print("========================================================\n")
